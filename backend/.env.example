NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://hss_finance:hss_finance_dev@localhost:5433/hss_finance
DATABASE_LOGGING=false
JWT_SECRET=<base64-encoded-random-secret-of-at-least-32-bytes>

# Pluggy Open Finance (Sandbox) — not yet wired into the app (see Slice 6.4).
# Never commit real values. PLUGGY_CLIENT_ID/SECRET are issued per-application in the
# Pluggy dashboard; the API key obtained with them expires after 2h and the Connect
# Token issued from it expires after 30min (both handled internally by the adapter).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Optional, Sandbox-only. Used solely by backend/scripts/validate-pluggy-sandbox.ts to
# validate against an existing Sandbox Item without hardcoding an id in code. Leave empty.
PLUGGY_SANDBOX_ITEM_ID=
