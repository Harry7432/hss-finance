{
  "name": "@hss-finance/backend",
  "version": "0.1.0",
  "private": true,
  "description": "HSS Finance API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migration:run": "tsx src/database/scripts/migrate.ts run",
    "migration:revert": "tsx src/database/scripts/migrate.ts revert",
    "migration:show": "tsx src/database/scripts/migrate.ts show",
    "validate:pluggy-sandbox": "tsx scripts/validate-pluggy-sandbox.ts",
    "validate:asaas-sandbox": "tsx scripts/validate-asaas-sandbox.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --watch",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check ."
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cookie": "1.1.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.4",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "neostandard": "0.13.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
